# Modele des variables d'environnement : copier en .env.local et remplir.
# Ne jamais mettre de vraie valeur ici : ce fichier est publie sur GitHub.

# Supabase (Project Settings > Data API et API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Serveur uniquement : contourne toute la securite RLS. Jamais de prefixe NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Emails (Resend) : notifications et rapport hebdomadaire
RESEND_API_KEY=
CONTACT_EMAIL=

# Tache hebdomadaire Vercel Cron (purge RGPD, rapport)
CRON_SECRET=

# Mot de passe de l'admin actuel : remplace par les comptes Supabase en semaine 2
ADMIN_PASSWORD=
