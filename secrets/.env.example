# =============================================================================
# .env.example : MODELE PUBLIC DES VARIABLES D'ENVIRONNEMENT
# =============================================================================
# Role : liste les variables attendues par le projet, sans aucune valeur.
# Ce fichier PEUT etre commite et partage.
#
# Utilisation : copier ce fichier en ".env" puis renseigner les valeurs.
# Le fichier ".env" est prive et ne doit JAMAIS etre commite.
#
# Ne jamais mettre de vraie clef dans ce fichier.
# =============================================================================


# --- Google (Cloud / Gemini / OAuth) ---
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Notion ---
NOTION_API_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- YouTube (Data API) ---
YOUTUBE_API_KEY=

# --- Vercel ---
VERCEL_TOKEN=

# --- GitHub ---
GITHUB_TOKEN=

# --- ScrapeGraphAI ---
SGAI_API_KEY=
