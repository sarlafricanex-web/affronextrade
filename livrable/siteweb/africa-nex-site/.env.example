# Modele des variables d'environnement : copier en .env.local et remplir.
# Ne jamais mettre de vraie valeur ici : ce fichier est publie sur GitHub.

# Supabase (Project Settings > Data API et API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Serveur uniquement : contourne toute la securite RLS. Jamais de prefixe NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Emails (Resend) : notifications et rapport hebdomadaire
RESEND_API_KEY=
# Adresse d'AFRICA NEX qui recoit les notifications internes (demandes, devis, decisions, messages)
CONTACT_EMAIL=
# Notifications aux utilisateurs (src/lib/notify) :
#   EMAIL_DELIVERY=resend  -> envoi reel (production). Vide -> mode journal : rien ne part,
#                             chaque email est seulement trace dans la table email_notifications.
#   EMAIL_FROM             -> expediteur, une fois le domaine verifie dans Resend
#                             (ex. AFRICA NEX <notifications@votre-domaine>). Vide -> expediteur de test Resend.
#   EMAIL_REDIRECT_TO      -> tests : tout part vers cette adresse au lieu du vrai destinataire.
#   SITE_URL               -> adresse du site dans les liens des emails (vide -> http://localhost:3000).
EMAIL_DELIVERY=
EMAIL_FROM=
EMAIL_REDIRECT_TO=
SITE_URL=

# Tache hebdomadaire Vercel Cron (purge RGPD, rapport)
CRON_SECRET=

# L'administration passe par un compte Supabase de role admin :
# node supabase/scripts/promote-admin.mjs email@exemple.com
